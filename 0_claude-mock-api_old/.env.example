# Mock API Key — users send this in the Authorization header
# Change this to any string you want; restart the server after changing
MOCK_API_KEY=mock-api-key-change-me

# Server settings
HOST=0.0.0.0
PORT=8000

# Path to the Claude CLI binary (default: "claude" assumes it's on PATH)
CLAUDE_CLI_PATH=claude

# Default max tokens for Claude responses
MAX_TOKENS=4096

# CORS allowed origins (comma-separated, * for all)
ALLOWED_ORIGINS=*
